# DPN PlantPulse mobile public runtime configuration
# These values are embedded in the client build. NEVER place secrets here.

# DPN Platform API base URL.
EXPO_PUBLIC_DPN_PLATFORM_BASE_URL=

# DPN Identity / DPN One OIDC public client configuration.
# The issuer must expose OpenID Connect discovery plus authorization,
# token, UserInfo, and preferably revocation endpoints.
EXPO_PUBLIC_DPN_IDENTITY_ISSUER=
EXPO_PUBLIC_DPN_IDENTITY_CLIENT_ID=
EXPO_PUBLIC_DPN_IDENTITY_SCOPES=openid profile email offline_access
EXPO_PUBLIC_DPN_IDENTITY_TENANT_CLAIM=tenant_id

# EAS project ID used when requesting an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Never add client secrets, access tokens, refresh tokens, database passwords,
# S3 credentials, private keys, or other secrets to EXPO_PUBLIC_* variables.
