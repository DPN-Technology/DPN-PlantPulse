# DPN PlantPulse mobile public runtime configuration
# These values are embedded in the client build. NEVER place secrets here.

# Production or development DPN Platform API base URL.
# Example production shape: https://plantpulse-api.example.com
# Example local LAN shape for a development device: http://192.168.1.50:8787
EXPO_PUBLIC_DPN_PLATFORM_BASE_URL=

# EAS project ID used when requesting an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Never add access tokens, refresh tokens, database passwords,
# S3 credentials, private keys, or other secrets to EXPO_PUBLIC_* variables.
