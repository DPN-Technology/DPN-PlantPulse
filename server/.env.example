# PlantPulse Platform Service
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://plantpulse:plantpulse@localhost:5432/plantpulse

# Production identity
PLATFORM_AUTH_MODE=jwks
DPN_IDENTITY_ISSUER=https://identity.example.invalid/
DPN_IDENTITY_AUDIENCE=dpn-plantpulse
DPN_IDENTITY_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
DPN_TENANT_CLAIM=tenant_id

# S3-compatible object storage
S3_REGION=us-east-1
S3_BUCKET=plantpulse
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_TTL_SECONDS=900
MAX_IMAGE_UPLOAD_BYTES=15728640

# Standard AWS SDK credential variables are used when needed:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
